# Copy this file to .env for local overrides.
# Never commit real secrets. .env is gitignored.
# This project runs locally with SQLite + optional Ollama; no cloud API keys are required.

# SQLite URL used by the FastAPI app (default: data/grc_agent.db)
# GRC_DATABASE_URL=sqlite:///data/grc_agent.db

# Risk agent: mock (default, no LLM) or ollama (local HTTP API)
# GRC_RISK_AGENT=mock
# GRC_RISK_AGENT=ollama

# Local Ollama chat + embeddings (only used when GRC_RISK_AGENT=ollama)
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_TIMEOUT_SECONDS=180

# RAG: enabled only when BOTH GRC_RISK_AGENT=ollama AND GRC_RAG_ENABLED=true
# GRC_RAG_ENABLED=false
# GRC_RAG_DEBUG=false
